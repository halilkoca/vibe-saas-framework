# ─────────────────────────────────────────────────────────────
# SUPABASE — public (client'a gider, gizli değil)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxx

# ─────────────────────────────────────────────────────────────
# SUPABASE — GİZLİ! Sadece server-side kullanılır.
# ASLA "NEXT_PUBLIC_" prefix'i ile kullanma, ASLA client component'e geçirme.
# Bu key ile RLS bypass edilir — sızarsa tüm tenant'ların verisi tehlikeye girer.
# ─────────────────────────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=xxxxx

# ─────────────────────────────────────────────────────────────
# CLOUDFLARE TURNSTILE (captcha) — cloudflare.com/turnstile üzerinden ücretsiz alınır
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ─────────────────────────────────────────────────────────────
# RATE LIMIT (opsiyonel — boş bırakılırsa in-memory fallback kullanılır,
# tek instance için yeterli ama production'da Upstash önerilir)
# ─────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─────────────────────────────────────────────────────────────
# BILLING (opsiyonel — billing modülü açıksa doldur)
# ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
